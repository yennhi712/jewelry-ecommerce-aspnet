@{
    ViewData["Title"] = "Tin tức";
}

<style>
    /* ==== PHONG CÁCH CHUNG ==== */
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #fffdf7;
        color: #333;
    }

    .title-container {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 50px auto 40px;
        text-align: center;
        max-width: 800px;
    }

    .title {
        font-size: 32px;
        color: #b8860b;
        font-weight: 700;
        margin: 0 15px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .title-hr-left, .title-hr-right {
        border: 0;
        border-top: 3px solid #b8860b;
        flex: 1;
    }

    /* ==== BẢNG GIÁ VÀNG ==== */
    .table-responsive {
        max-width: 70%;
        margin: 0 auto 60px;
    }

    .table-style-custom {
        width: 100%;
        border-collapse: collapse;
        background: #fffaf0;
        box-shadow: 0 0 10px rgba(184, 134, 11, 0.15);
        border-radius: 10px;
        overflow: hidden;
    }

        .table-style-custom thead {
            background: linear-gradient(90deg, #b8860b, #e6c97a);
            color: white;
        }

        .table-style-custom th, .table-style-custom td {
            text-align: center;
            padding: 14px;
            font-size: 17px;
            border: 1px solid #f1e1a6;
        }

        .table-style-custom tbody tr:hover {
            background-color: #fff3cd;
            transition: 0.3s;
        }

    /* ==== TIN TỨC HÌNH ẢNH ==== */
    .image-container {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        margin: 0 auto 60px;
        max-width: 2250px;
        padding: 0 30px;
    }

    .large-image {
        flex: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background: #fffaf0;
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(184, 134, 11, 0.2);
        padding: 30px;
        min-height: 600px;
        height: auto;
    }

    .img-large {
        width: 80%; /* ✅ giảm kích thước xuống 80% khung */
        max-width: 700px; /* ✅ không vượt quá 700px */
        border-radius: 10px;
        margin-bottom: 15px;
        transition: transform 0.4s ease;
        display: block;
        margin-left: auto;
        margin-right: auto; /* ✅ căn giữa */
    }


        .img-large:hover {
            transform: scale(1.03);
        }

    .small-images {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 25px;
    }

    .small-box {
        text-align: center;
        background: #fffaf0;
        border-radius: 12px;
        padding: 15px;
        box-shadow: 0 0 10px rgba(184, 134, 11, 0.2);
        transition: transform 0.3s ease;
        width: 100%;
        position: relative;
        z-index: 1;
    }

        .small-box:hover {
            transform: translateY(-5px);
        }

    .img-small {
        width: 100%;
        max-width: 250px;
        border-radius: 10px;
        margin-bottom: 10px;
    }

    .image-caption {
        font-size: 22px;
        font-weight: 600;
        color: #b8860b;
        margin-top: 5px;
    }

    .image-text, .image-text2 {
        font-size: 16px;
        color: #333 !important;
        line-height: 1.6;
        padding: 0 10px;
        text-align: justify;
        display: block;
    }

    .fade-in {
        animation: fadeIn 1.2s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- ====== TIÊU ĐỀ GIÁ VÀNG ====== -->
